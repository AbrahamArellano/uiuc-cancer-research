# ============================================================================
# UIUC Cancer Research - Environment Variables Example
# ============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# Note: .env is git-ignored and will not be committed
# ============================================================================

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================

# Project root directory (absolute path)
# Default: auto-detected from script location
PROJECT_ROOT=/path/to/uiuc-cancer-research

# ============================================================================
# DATA SOURCE CREDENTIALS
# ============================================================================

# COSMIC Database Credentials
# Register at: https://cancer.sanger.ac.uk/cosmic/register
COSMIC_EMAIL=your.email@example.com
COSMIC_PASSWORD=your_cosmic_token_here
COSMIC_VERSION=v102
COSMIC_ASSEMBLY=GRCh38

# GDC (Genomic Data Commons) Token (Optional)
# For controlled-access TCGA data
# Download from: https://portal.gdc.cancer.gov/
GDC_TOKEN_PATH=/path/to/gdc-user-token.txt

# ============================================================================
# DATA CONFIGURATION
# ============================================================================

# ClinVar Assembly
CLINVAR_ASSEMBLY=GRCh38

# TCGA Project
TCGA_PROJECT=TCGA-PRAD

# AlphaMissense Assembly
ALPHAMISSENSE_ASSEMBLY=hg38

# ============================================================================
# VEP (VARIANT EFFECT PREDICTOR) CONFIGURATION
# ============================================================================

# VEP cache directory
# Default: ~/.vep
VEP_CACHE_DIR=/home/yourusername/.vep

# VEP version and assembly
VEP_VERSION=110
VEP_ASSEMBLY=GRCh38
VEP_SPECIES=homo_sapiens

# ============================================================================
# TABNET MODEL PARAMETERS
# ============================================================================

# Model architecture
TABNET_N_D=64                    # Decision prediction layer width
TABNET_N_A=64                    # Attention embedding dimension
TABNET_N_STEPS=6                 # Number of decision steps
TABNET_GAMMA=1.3                 # Feature reuse parameter
TABNET_LAMBDA_SPARSE=0.001       # Sparsity regularization (1e-3)

# Training parameters
TABNET_MAX_EPOCHS=200
TABNET_PATIENCE=15               # Early stopping patience
TABNET_BATCH_SIZE=1024
TABNET_VIRTUAL_BATCH_SIZE=128
TABNET_LEARNING_RATE=0.02        # 2e-2

# Cross-validation
N_FOLDS=3

# Train/test split ratio
TRAIN_TEST_SPLIT=0.8

# Random seed for reproducibility
RANDOM_SEED=42

# ============================================================================
# HYPERPARAMETER OPTIMIZATION
# ============================================================================

# GPU time budget for optimization (in hours)
GPU_HOURS_BUDGET=36

# ============================================================================
# COMPUTE RESOURCES
# ============================================================================

# GPU configuration
GPU_ENABLED=true
CUDA_VISIBLE_DEVICES=0           # Which GPU to use (0, 1, 2, etc.)

# Parallel processing
NUM_WORKERS=4                    # Number of worker processes

# Memory limit (in GB)
MAX_MEMORY_GB=32

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file rotation
LOG_MAX_BYTES=10485760           # 10 MB
LOG_BACKUP_COUNT=5

# ============================================================================
# EXPERIMENT TRACKING (OPTIONAL)
# ============================================================================

# MLflow tracking
MLFLOW_TRACKING_URI=file:///path/to/uiuc-cancer-research/results/mlruns
MLFLOW_EXPERIMENT_NAME=prostate_cancer_variant_classification

# Weights & Biases (optional)
# Register at: https://wandb.ai/
WANDB_PROJECT=uiuc-cancer-research
WANDB_ENTITY=your_wandb_username
WANDB_API_KEY=your_wandb_api_key

# ============================================================================
# CLINICAL THRESHOLDS
# ============================================================================

# AlphaMissense pathogenicity thresholds
ALPHAMISSENSE_PATHOGENIC_THRESHOLD=0.564
ALPHAMISSENSE_BENIGN_THRESHOLD=0.34

# Population frequency threshold for filtering
MAX_POPULATION_FREQUENCY=0.01    # 1%

# VUS reduction target
VUS_REDUCTION_TARGET=0.065       # 6.5%

# ============================================================================
# VALIDATION & TESTING
# ============================================================================

# Enable strict validation
STRICT_VALIDATION=true

# Checkpointing
ENABLE_CHECKPOINTING=true
CHECKPOINT_FREQUENCY=10          # Save every N epochs

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your actual values:
#    nano .env  # or use your preferred editor
#
# 3. Set COSMIC credentials (required for data download)
#
# 4. Adjust paths to match your system
#
# 5. The .env file is automatically loaded by python-dotenv
#    in the pipeline scripts
#
# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# - NEVER commit the .env file to version control
# - .env is already in .gitignore
# - Keep your COSMIC credentials secure
# - GDC token is optional (only for controlled-access data)
# - All paths should be absolute, not relative
#
# ============================================================================
